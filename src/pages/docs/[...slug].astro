---
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/nav.astro";
import Footer from "@/components/footer.astro";
import Giscus from "@/components/Giscus.astro";
import DocSidebar from "@/components/DocSidebar.astro";
import { getCollection, render } from "astro:content";
import { getDocSections } from "@/lib/docs-sections";

export async function getStaticPaths() {
  const docs = await getCollection("docs");
  return docs.map((doc) => ({
    params: { slug: doc.id },
    props: { doc },
  }));
}

const { doc } = Astro.props;
const { Content } = await render(doc);

const sections = await getDocSections();

const currentSection = sections.find((s) => s.items.some((i) => i.id === doc.id));
const idx = currentSection?.items.findIndex((i) => i.id === doc.id) ?? -1;
const prev = idx > 0 ? currentSection?.items[idx - 1] : null;
const next = idx >= 0 && idx < (currentSection?.items.length ?? 0) - 1 ? currentSection?.items[idx + 1] : null;
---

<Layout title={doc.data.title}>
  <Nav />
  <main class="max-w-6xl mx-auto py-24 px-4">
    <div class="flex gap-8">
      <DocSidebar sections={sections} currentId={doc.id} />

      <div class="flex-1 min-w-0">
        <a href="/docs" class="text-[var(--sec)] hover:underline mb-6 inline-block">&larr; 返回文档</a>
        <article>
          <h1 class="text-4xl md:text-5xl font-medium text-[var(--white)] mb-4">{doc.data.title}</h1>
          {doc.data.description && (
            <p class="text-[var(--white-icon)] mb-8">{doc.data.description}</p>
          )}
          <div class="prose prose-invert max-w-none text-[var(--white)]">
            <Content />
          </div>
          <Giscus />
        </article>

        <div class="flex justify-between mt-12 pt-8 border-t border-[#ffffff10]">
          {prev ? (
            <a href={`/docs/${prev.id}`} class="text-[var(--sec)] hover:underline">&larr; {prev.title}</a>
          ) : <span />}
          {next ? (
            <a href={`/docs/${next.id}`} class="text-[var(--sec)] hover:underline">{next.title} &rarr;</a>
          ) : <span />}
        </div>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<style is:global>
  .prose h2 {
    font-size: 1.5rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 1rem;
    color: var(--white);
  }
  .prose h3 {
    font-size: 1.25rem;
    font-weight: 600;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
    color: var(--white);
  }
  .prose h4 {
    font-size: 1.125rem;
    font-weight: 600;
    margin-top: 1.25rem;
    margin-bottom: 0.5rem;
    color: var(--white);
  }
  .prose p {
    margin-bottom: 1rem;
    line-height: 1.75;
    color: var(--white-icon);
  }
  .prose ul, .prose ol {
    margin-bottom: 1rem;
    padding-left: 1.5rem;
  }
  .prose li {
    margin-bottom: 0.5rem;
    color: var(--white-icon);
  }
  .prose code {
    background: #1a1a2e;
    padding: 0.2rem 0.4rem;
    border-radius: 0.25rem;
    font-size: 0.875rem;
    color: var(--sec);
  }
  .prose pre {
    background: #1a1a2e;
    padding: 1rem;
    border-radius: 0.5rem;
    overflow-x: auto;
    margin-bottom: 1.5rem;
  }
  .prose pre code {
    background: none;
    padding: 0;
    color: var(--white);
  }
  .prose a {
    color: var(--sec);
    text-decoration: underline;
  }
  .prose strong {
    color: var(--white);
    font-weight: 600;
  }
  .prose hr {
    border-color: #ffffff10;
    margin: 2rem 0;
  }
  .prose blockquote {
    border-left: 3px solid var(--sec);
    padding-left: 1rem;
    margin: 1.5rem 0;
    color: var(--white-icon);
  }
</style>
