---
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/nav.astro";
import Footer from "@/components/footer.astro";
import DocSidebar from "@/components/DocSidebar.astro";
import { getDocSections } from "@/lib/docs-sections";

const sections = await getDocSections();
---

<Layout title="文档">
  <Nav />
  <main class="max-w-6xl mx-auto py-24 px-4">
    <h1 class="text-4xl md:text-5xl font-medium text-[var(--white)] mb-2">文档</h1>
    <p class="text-[var(--white-icon)] mb-10">从入门到进阶的 CTF 学习路径。</p>

    <div class="flex gap-8">
      <DocSidebar sections={sections} />

      <div class="flex-1 min-w-0 space-y-10">
        {
          sections.map((section) => (
            <div>
              <h2 class="text-2xl font-semibold text-[var(--white)] mb-4">{section.title}</h2>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                {section.items.map((doc) => (
                  <a
                    href={`/docs/${doc.id}`}
                    class="group block p-4 rounded-xl border border-[var(--white-icon-tr)] bg-[#1414149c] hover:bg-[var(--white-icon-tr)] hover:border-[var(--sec)] transition-all duration-300"
                  >
                    <h3 class="text-lg font-medium text-[var(--white)] group-hover:text-[var(--sec)] transition-colors">
                      {doc.title}
                    </h3>
                    {doc.description && (
                      <p class="text-sm text-[var(--white-icon)] mt-1">{doc.description}</p>
                    )}
                  </a>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </main>
  <Footer />
</Layout>
